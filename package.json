{
  "name": "local-llm-ui",
  "version": "1.0.0",
  "description": "A modern UI for interacting with local LLMs through Ollama, LM Studio, and other providers. Built with React, TypeScript, Vite, and shadcn/ui",
  "type": "module",
  "author": "Praveen Chamarthi",
  "license": "MIT",
  "keywords": [
    "llm",
    "local-llm",
    "chat-ui",
    "ollama",
    "lm-studio",
    "chatbot",
    "ai-chat",
    "shadcn",
    "react",
    "typescript",
    "vite",
    "local-ai",
    "llm-interface"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/praveenc/local-llm-ui.git"
  },
  "bugs": {
    "url": "https://github.com/praveenc/local-llm-ui/issues"
  },
  "homepage": "https://github.com/praveenc/local-llm-ui#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.133",
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/cerebras": "^3.0.85",
    "@ai-sdk/groq": "^4.0.77",
    "@ai-sdk/mcp": "^2.0.91",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@aws-sdk/client-bedrock": "^3.1163.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1163.0",
    "@aws-sdk/credential-providers": "^3.1163.0",
    "@lmstudio/sdk": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/code": "^2.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "nanoid": "^6.0.2",
    "ollama-ai-provider-v2": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
